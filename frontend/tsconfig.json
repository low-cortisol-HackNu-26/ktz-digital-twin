{
  "_comment": "TypeScript config for Next.js 15 app router.",
  "_settings": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    "strict": true,
    "paths": {
      "@/*": ["./"],
      "shared/*": ["../shared/*"]
    },
    "plugins": [{ "name": "next" }]
  }
}
