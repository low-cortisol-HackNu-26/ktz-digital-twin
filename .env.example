# Copy this file to .env and fill in values before running docker compose up
#
# PostgreSQL
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=locomotive_twin
# DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/locomotive_twin
#
# Redis
# REDIS_URL=redis://redis:6379/0
#
# Auth (card-based JWT — no Keycloak)
# SECRET_KEY=                  # HS256 signing key; minimum 32 random characters
# TOKEN_LIFETIME_HOURS=8       # one operator shift
# ALLOWED_ORIGINS=http://localhost:3000
#
# Celery
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
#
# Frontend
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost/ws
#
# Simulator
# INGEST_URL=http://backend:8000/api/ingest/telemetry
# LOCOS=KZ8A-0001,KZ8A-0002,KZ8A-0003
# HZ=5
# SCENARIO=normal              # normal | overspeed | brake_pressure_drop | motor_overheat | catenary_voltage_sag | gearbox_vibration_high | burst_x10
# SIMULATOR_TARGET_WS=ws://backend:8000/ws/ingest   # legacy, auto-converted to INGEST_URL if set
# SIMULATOR_LOCOMOTIVE_ID=KZ8A-0001                 # legacy single-loco mode
# SIMULATOR_HZ=5
# SIMULATOR_SCENARIO=normal
# RANDOM_WARNINGS_ENABLED=true
# WARNING_DURATION_SECONDS=6
# WARNING_COOLDOWN_SECONDS=4
# WARNING_PROBABILITY_PER_TICK=0.015
# ENABLED_WARNING_TYPES=overspeed,high_temperature,low_signal_quality,voltage_sag,high_vibration,bad_track_upcoming
# MAX_ACTIVE_WARNINGS_PER_LOCOMOTIVE=2
