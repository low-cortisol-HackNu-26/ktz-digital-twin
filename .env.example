# Copy this file to .env and fill in values before running docker compose up
#
# PostgreSQL
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=locomotive_twin
# DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/locomotive_twin
#
# Redis
# REDIS_URL=redis://redis:6379/0
#
# Auth (card-based JWT — no Keycloak)
# SECRET_KEY=                  # HS256 signing key; minimum 32 random characters
# TOKEN_LIFETIME_HOURS=8       # one operator shift
# ALLOWED_ORIGINS=http://localhost:3000
#
# Celery
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
#
# Frontend
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost/ws
#
# Simulator
# SIMULATOR_TARGET_WS=ws://backend:8000/ws/ingest
# SIMULATOR_LOCOMOTIVE_ID=LOC-001
# SIMULATOR_HZ=1               # packets per second; set 10 for highload test
# SIMULATOR_SCENARIO=normal    # normal | anomaly | highload
